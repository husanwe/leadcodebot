{
  "imports": {
    "@neondatabase/serverless": "npm:@neondatabase/serverless@^1.1.0",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.4",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4",
    "grammy": "https://deno.land/x/grammy@v1.44.0/mod.ts"
  },
  "tasks": {
    "dc:watch": "docker compose -f docker-compose.dev.yaml watch",
    "dc:down": "docker compose -f docker-compose.dev.yaml down -v",
    "db:push": "deno --env -A --node-modules-dir npm:drizzle-kit@rc push"
  }
}
